<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="520" viewBox="0 0 1200 520">
  <rect width="1200" height="520" fill="#0A0E14"/>
  <defs>
    <radialGradient id="glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#22D3EE" stop-opacity="1"/>
      <stop offset="100%" stop-color="#22D3EE" stop-opacity="0"/>
    </radialGradient>
    <path id="flow-main" d="M120 80 L120 160 L260 160 L260 240 L400 240 L400 320 L540 320 L540 400 L680 400"/>
    <path id="flow-rag" d="M120 80 L320 80 L320 160 L400 160 L400 240"/>
    <path id="flow-mcp" d="M120 80 L520 80 L520 160 L400 160 L400 240"/>
    <path id="flow-agents" d="M120 80 L720 80 L720 160 L400 160 L400 240"/>
    <path id="flow-platform-sre" d="M400 240 L400 320 L540 320"/>
    <path id="flow-platform-devsecops" d="M400 240 L400 280 L540 280"/>
    <path id="flow-platform-finops" d="M400 240 L400 360 L540 360"/>
  </defs>

  <g stroke="#2A3140" stroke-width="2" fill="none" stroke-linecap="round">
    <path d="M120 80 L120 160 L260 160 L260 240 L400 240 L400 320 L540 320 L540 400 L680 400"/>
    <path d="M120 80 L320 80 L320 160 L400 160 L400 240"/>
    <path d="M120 80 L520 80 L520 160 L400 160 L400 240"/>
    <path d="M120 80 L720 80 L720 160 L400 160 L400 240"/>
    <path d="M400 240 L400 280 L540 280"/>
    <path d="M400 240 L400 360 L540 360"/>
    <path d="M540 280 L540 240 L680 240"/>
    <path d="M540 320 L680 320"/>
    <path d="M540 360 L540 400 L680 400"/>
    <path d="M680 240 L680 160 L820 160"/>
    <path d="M680 320 L820 320"/>
    <path d="M680 400 L680 480 L820 480"/>
    <path d="M820 160 L960 160"/>
    <path d="M820 320 L960 320"/>
    <path d="M820 480 L960 480"/>
  </g>

  <g font-family="SFMono-Regular, Consolas, monospace" font-size="13" fill="#8B96A8" text-anchor="middle">
    <g>
      <rect x="50" y="52" width="140" height="56" rx="12" fill="#121826" stroke="#2A3140"/>
      <text x="120" y="86">AI Engineering</text>
    </g>
    <g>
      <rect x="250" y="52" width="140" height="56" rx="12" fill="#121826" stroke="#2A3140"/>
      <text x="320" y="86">RAG</text>
    </g>
    <g>
      <rect x="450" y="52" width="140" height="56" rx="12" fill="#121826" stroke="#2A3140"/>
      <text x="520" y="86">MCP</text>
    </g>
    <g>
      <rect x="650" y="52" width="140" height="56" rx="12" fill="#121826" stroke="#2A3140"/>
      <text x="720" y="86">Agents</text>
    </g>
    <g>
      <rect x="330" y="212" width="140" height="56" rx="12" fill="#121826" stroke="#2A3140"/>
      <text x="400" y="246">AI Platform</text>
    </g>
    <g>
      <rect x="470" y="292" width="140" height="56" rx="12" fill="#121826" stroke="#2A3140"/>
      <text x="540" y="326">Platform Eng</text>
    </g>
    <g>
      <rect x="470" y="212" width="140" height="56" rx="12" fill="#121826" stroke="#2A3140"/>
      <text x="540" y="246">DevSecOps</text>
    </g>
    <g>
      <rect x="470" y="372" width="140" height="56" rx="12" fill="#121826" stroke="#2A3140"/>
      <text x="540" y="406">FinOps</text>
    </g>
    <g>
      <rect x="610" y="212" width="140" height="56" rx="12" fill="#121826" stroke="#2A3140"/>
      <text x="680" y="246">SRE</text>
    </g>
    <g>
      <rect x="610" y="292" width="140" height="56" rx="12" fill="#121826" stroke="#2A3140"/>
      <text x="680" y="326">Kubernetes</text>
    </g>
    <g>
      <rect x="610" y="452" width="140" height="56" rx="12" fill="#121826" stroke="#2A3140"/>
      <text x="680" y="486">Containers</text>
    </g>
    <g>
      <rect x="750" y="132" width="140" height="56" rx="12" fill="#121826" stroke="#2A3140"/>
      <text x="820" y="166">Cloud</text>
    </g>
    <g>
      <rect x="750" y="292" width="140" height="56" rx="12" fill="#121826" stroke="#2A3140"/>
      <text x="820" y="326">Networking</text>
    </g>
    <g>
      <rect x="750" y="452" width="140" height="56" rx="12" fill="#121826" stroke="#2A3140"/>
      <text x="820" y="486">Linux</text>
    </g>
  </g>

  <circle r="14" fill="url(#glow)">
    <animateMotion dur="9s" repeatCount="indefinite" rotate="0">
      <mpath href="#flow-main"/>
    </animateMotion>
  </circle>
  <circle r="4" fill="#67E8F9">
    <animateMotion dur="9s" repeatCount="indefinite" rotate="0">
      <mpath href="#flow-main"/>
    </animateMotion>
  </circle>

  <circle r="10" fill="url(#glow)" opacity="0.9">
    <animateMotion dur="7s" repeatCount="indefinite" rotate="0">
      <mpath href="#flow-rag"/>
    </animateMotion>
  </circle>
  <circle r="3" fill="#67E8F9">
    <animateMotion dur="7s" repeatCount="indefinite" rotate="0">
      <mpath href="#flow-rag"/>
    </animateMotion>
  </circle>

  <circle r="10" fill="url(#glow)" opacity="0.8">
    <animateMotion dur="7.5s" repeatCount="indefinite" rotate="0">
      <mpath href="#flow-mcp"/>
    </animateMotion>
  </circle>
  <circle r="3" fill="#67E8F9">
    <animateMotion dur="7.5s" repeatCount="indefinite" rotate="0">
      <mpath href="#flow-mcp"/>
    </animateMotion>
  </circle>

  <circle r="10" fill="url(#glow)" opacity="0.7">
    <animateMotion dur="8s" repeatCount="indefinite" rotate="0">
      <mpath href="#flow-agents"/>
    </animateMotion>
  </circle>
  <circle r="3" fill="#67E8F9">
    <animateMotion dur="8s" repeatCount="indefinite" rotate="0">
      <mpath href="#flow-agents"/>
    </animateMotion>
  </circle>

  <text x="600" y="28" font-family="SFMono-Regular, Consolas, monospace" font-size="15" fill="#4C566A" text-anchor="middle" letter-spacing="2">THE ENGINEERING UNIVERSE</text>
</svg>
